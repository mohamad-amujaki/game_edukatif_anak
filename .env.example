# PostgreSQL. Salin ke `.env` dengan kredensial Anda (jangan commit `.env`).
# Prisma Postgres: `DATABASE_URL` = Pooled; `DATABASE_DIRECT_URL` = Direct (wajib untuk `migrate` di Fly jika URL utama pooled).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/game_edukatif?schema=public"
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/game_edukatif?schema=public"
PIN_HASH_PEPPER="change-me-32chars-minimum-random"

# Frontend Vite: URL API publik jika UI dan API beda origin (mis. Netlify → Railway).
# Kosongkan untuk dev (pakai proxy Vite) atau jika UI dan API sama-origin.
# Contoh produksi: VITE_API_URL="https://api-anda.example.com"
# VITE_API_URL=

# better-auth (panel admin). SECRET minimal 32 karakter (openssl rand -base64 32).
BETTER_AUTH_SECRET=""
# Lokal: di **development** base URL auth mengikuti port Vite (5173/5174, dll.) lewat proxy; `BETTER_AUTH_URL`
# di sini hanya **fallback** bila host tidak terbaca. Di **production** wajib URL publik browser (Netlify, dll.).
BETTER_AUTH_URL="http://localhost:5173"

# OAuth Google (opsional) — daftar/masuk orang tua. Keduanya harus di-set agar `GET /api/health` → data.googleOAuth: true.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI (ganti origin dengan BETTER_AUTH_URL Anda, tanpa slash akhir):
#   {BETTER_AUTH_URL}/api/auth/callback/google
# Contoh lokal port default: http://localhost:5173/api/auth/callback/google
# Contoh Vite port 5174: http://localhost:5174/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Server API: tambahan origin untuk CORS/Better Auth (pisahkan koma). Domain Netlify sudah default di kode.
# CORS_ORIGINS="https://staging.example.com"

# Sentry Node (API). Kosongkan jika tidak dipakai (§9 rekomendasi DX).
# SENTRY_DSN=
# Sampling performa (0 = mati; staging bisa 0.1–1).
# SENTRY_TRACES_SAMPLE_RATE=0

# Playwright admin smoke (login /admin/analytics). CI memakai user dari `pnpm admin:create`.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
