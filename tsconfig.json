{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@mainceria/api-client": ["packages/api-client/src/index.ts"],
      "@mainceria/types": ["packages/types/src/index.ts"],
      "@mainceria/utils": ["packages/utils/src/index.ts"],
      "@mainceria/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/web/src",
    "apps/api/src",
    "packages",
    "prisma",
    "prisma.config.ts",
    "scripts",
    "e2e"
  ]
}
