{
  "name": "game-edukatif-anak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build && prisma generate",
    "start": "prisma migrate deploy && node --import tsx/esm server/index.ts",
    "start:server": "node --import tsx/esm server/index.ts",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "cron:weekly-email": "tsx scripts/weekly-parent-email.ts",
    "auth:generate": "npx auth@latest generate --config server/auth.ts --adapter prisma --dialect postgresql --output prisma/better-auth-schema.prisma -y",
    "postinstall": "prisma generate",
    "bank:validate": "tsx scripts/bank-validate.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.9",
    "@hono/node-server": "^1.14.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.51.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.120.20",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.9",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "hono": "^4.7.10",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.8",
    "jotai": "^2.12.5",
    "lottie-react": "^2.4.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.6",
    "react-qr-code": "^2.0.21",
    "recharts": "^3.8.1",
    "tsx": "^4.19.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0"
  }
}
